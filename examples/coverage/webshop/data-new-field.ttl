# The same catalogue, with a new property (shop:giftWrap) on the books that
# no rule checks yet.
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix shop:   <http://example.org/shop#> .
@prefix p:      <http://example.org/shop/product/> .


p:000 a schema:Product ;
    schema:sku "SKU-10000" ;
    schema:name "Atlas" ;
    schema:category shop:Books ;
    shop:giftWrap true ;
    schema:offers [
        a schema:Offer ;
        schema:price 9.95 ;
        schema:priceCurrency "EUR" ;
        schema:validFrom "2026-01-01"^^xsd:date ;
        schema:validThrough "2026-12-31"^^xsd:date
    ] .

