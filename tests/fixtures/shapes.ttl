@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <http://example.org/ns#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .

ex:PersonShape
    a sh:NodeShape ;
    rdfs:label "Person" ;
    sh:targetClass ex:Person ;
    sh:property [
        sh:path ex:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path ex:email ;
        sh:pattern "^[^@]+@[^@]+$" ;
        sh:message "Email address must contain exactly one @"@en ;
    ] ;
    sh:property [
        sh:path ex:age ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 150 ;
    ] ;
    sh:property ex:PersonWorksForShape .

ex:PersonWorksForShape
    a sh:PropertyShape ;
    sh:name "employer" ;
    sh:path ex:worksFor ;
    sh:class ex:Organisation ;
    sh:severity sh:Warning .

ex:OrganisationShape
    a sh:NodeShape ;
    sh:targetClass ex:Organisation ;
    sh:property [
        sh:path ex:name ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path ( ex:address ex:country ) ;
        sh:in ( "BE" "NL" "LU" ) ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath ex:worksFor ] ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Organisation has no employees" ;
    ] .
